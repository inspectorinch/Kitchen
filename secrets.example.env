# Every secret this project may need, one per line. The real values go in secrets/local.env (never committed).
# The owner fills these in from the guides in docs/owner/. Agents see only which names are set: node .ox/check-secrets.mjs

# Firebase (dev project)
FIREBASE_DEV_PROJECT_ID=

# AI vendors for the gateway and the bake-off (only the ones being tested)
GOOGLE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Dedicated receipt service (name chosen by the researcher)
RECEIPT_SERVICE_API_KEY=

# Instacart Developer Platform
INSTACART_API_KEY=

# Order emails: inbound-mail service for the forwarding address
MAIL_INTAKE_WEBHOOK_SECRET=
MAIL_INTAKE_DOMAIN=

# Gmail connect (off until Google approves)
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=

# Online recipe source (name chosen by the researcher)
RECIPE_SEARCH_API_KEY=

# Store subscriptions
SUBSCRIPTIONS_API_KEY=
